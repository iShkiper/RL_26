Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nArms", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nSteps", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trueMeans", "=", 
   RowBox[{"{", 
    RowBox[{"0.5", ",", 
     RowBox[{"-", "1.0"}], ",", "2.5", ",", "1.5", ",", "0.0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"taus", "=", 
    RowBox[{"{", 
     RowBox[{"0.2", ",", "1.0", ",", "3.0"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sums", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "nArms"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"counts", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", "nArms"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"arm", "=", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{"Range", "[", "nArms", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"reward", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{
         RowBox[{"trueMeans", "[", 
          RowBox[{"[", "arm", "]"}], "]"}], ",", "sigma"}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sums", "[", 
       RowBox[{"[", "arm", "]"}], "]"}], "+=", "reward"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"counts", "[", 
       RowBox[{"[", "arm", "]"}], "]"}], "+=", "1"}]}], ",", 
    RowBox[{"{", "nSteps", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{"sums", "/", "counts"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Q", "=", 
    RowBox[{"Q", "/.", 
     RowBox[{"Indeterminate", "\[Rule]", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"softmax", "[", 
     RowBox[{"Q_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"Q", "/", "tau"}], "]"}], "/", 
     RowBox[{"Total", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"Q", "/", "tau"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"probs", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"softmax", "[", 
       RowBox[{"Q", ",", "tau"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"tau", ",", "taus"}], "}"}]}], "]"}]}], ";"}], 
