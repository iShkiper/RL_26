   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "showQ", ",", "True", ",", 
       "\"\<\:041f\:043e\:043a\:0430\:0437\:0430\:0442\:044c Q\>\""}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}]}], "}"}], ",", 
   RowBox[{"Initialization", "\[RuleDelayed]", 
    RowBox[{"(", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "t", "}"}], ",", 
       RowBox[{
        RowBox[{"K", "=", "5"}], ";", "\[IndentingNewLine]", 
        RowBox[{"mu", "=", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "1.0", ",", "2.5", ",", "1.5", ",", "2.0"}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sigma", "=", "0.5"}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxSteps", "=", "500"}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", "=", "2.0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sums", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "K"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"counts", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"1", ",", "K"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sumsHistory", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "maxSteps", "}"}], ",", 
           RowBox[{"{", "K", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"countsHistory", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", "maxSteps", "}"}], ",", 
           RowBox[{"{", "K", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"t", "=", "2"}], ",", 
          RowBox[{"t", "\[LessEqual]", "maxSteps"}], ",", 
          RowBox[{"t", "++"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"t", "\[LessEqual]", "K"}], ",", 
             RowBox[{
              RowBox[{"arm", "=", "t"}], ";"}], ",", 
             RowBox[{
              RowBox[{"ucb", "=", 
               RowBox[{
                RowBox[{"sums", "/", 
                 RowBox[{"(", "counts", ")"}]}], "+", 
                RowBox[{"c", "*", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   RowBox[{"Log", "[", "t", "]"}], "/", 
                   RowBox[{"(", "counts", ")"}]}], "]"}]}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"arm", "=", 
               RowBox[{
                RowBox[{"Ordering", "[", 
                 RowBox[{"ucb", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"reward", "=", 
            RowBox[{"RandomVariate", "[", 
             RowBox[{"NormalDistribution", "[", 
              RowBox[{
               RowBox[{"mu", "[", 
                RowBox[{"[", "arm", "]"}], "]"}], ",", "sigma"}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"sums", "[", 
             RowBox[{"[", "arm", "]"}], "]"}], "+=", "reward"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"counts", "[", 
             RowBox[{"[", "arm", "]"}], "]"}], "+=", "1"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"sumsHistory", "[", 
             RowBox[{"[", "t", "]"}], "]"}], "=", "sums"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"countsHistory", "[", 
             RowBox[{"[", "t", "]"}], "]"}], "=", "counts"}], ";"}]}], "]"}], 
        ";"}]}], "]"}], ")"}]}], ",", 
   RowBox[{"SaveDefinitions", "\[Rule]", "True"}]}], "]"}]], "Input",
