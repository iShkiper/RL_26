               RowBox[{"mu", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ",", "Black", 
         ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<N = \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"cntNow", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", "12", ",", 
               "Bold"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{
                RowBox[{"ucbNow", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "+", "0.15"}]}], "}"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ",", 
