Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"qNow", "=", 
     RowBox[{
      RowBox[{"sumsHistory", "[", 
       RowBox[{"[", "t", "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"countsHistory", "[", 
        RowBox[{"[", "t", "]"}], "]"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ucbNow", "=", 
     RowBox[{"qNow", "+", 
      RowBox[{"c", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Log", "[", "t", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"countsHistory", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ")"}]}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cntNow", "=", 
     RowBox[{"countsHistory", "[", 
      RowBox[{"[", "t", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"BarChart", "[", 
     RowBox[{"ucbNow", ",", 
      RowBox[{"ChartLabels", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<1\>\"", ",", "\"\<2\>\"", ",", "\"\<3\>\"", ",", "\"\<4\>\"", 
         ",", "\"\<5\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "\[Rule]", 
       RowBox[{"\"\<UCB (c = \>\"", "<>", 
        RowBox[{"ToString", "[", "c", "]"}], "<>", 
        "\"\<) \:043d\:0430 \:0448\:0430\:0433\:0435 \>\"", "<>", 
        RowBox[{"ToString", "[", "t", "]"}]}]}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "500"}], ",", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\:0420\:044b\:0447\:0430\:0433\>\"", ",", "\"\<UCB\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", ".1"}], ",", 
         RowBox[{
          RowBox[{"Max", "[", "mu", "]"}], "+", "3"}]}], "}"}]}], ",", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
         RowBox[{"Table", "[", 
